#!/bin/bash

# Focused window glows; unfocused windows get a faint outline.
# Keep width below half of AeroSpace's inner gap so neighbouring borders never touch.
options=(
  # round follows each window's own corner radius; uniform (fixed 9pt) and
  # square (needs width >= 52 on macOS 26) both mismatch the window corners.
  style=round
  width=3.0
  hidpi=on
  # Nord palette: nord8 frost blue glow, nord3 faint outline
  active_color="glow(0xff88c0d0)"
  inactive_color=0x804c566a
  # Matched against the process name, which is lowercase
  whitelist="ghostty"
)

borders "${options[@]}"
