#!/bin/sh

# Start an MCP server only when Claude Code runs inside exactly this repository.
# Claude Code shares a project's local-scope servers with its git worktrees;
# a worktree has its own top level, so it is refused here.
# Usage: mcp-guard <repo root> <command> [args...]
root=$1
shift
if [ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$root" ]; then
  echo "mcp-guard: $1 is only available in $root" >&2
  exit 1
fi
exec "$@"
