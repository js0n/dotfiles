#!/bin/bash

# List MCP servers for Claude Code and Codex by scope, across every project.
#   global:  every project        Claude ~/.claude.json, Codex ~/.codex/config.toml
#   local:   one folder, private  Claude ~/.claude.json, per project path
#   project: shared in the repo   Claude .mcp.json, Codex .codex/config.toml
#            (Claude asks to approve each; Codex reads it only in trusted projects)
# Account connectors from claude.ai and plugin servers are not in these files.
# Usage: mcps [-s]   -s adds a live health check for Claude Code servers
set -euo pipefail

STATUS=0
[ "${1:-}" = "-s" ] && STATUS=1

# The terminal theme's own ANSI colors, so dark and light themes both stay legible
BLUE=$'\033[34m'; CYAN=$'\033[36m'; GREEN=$'\033[32m'; RED=$'\033[31m'
YELLOW=$'\033[33m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
GUARD="$HOME/Workspace/dotfiles/claude/mcp-guard"
SEP=$'\x1f'

# Server JSON tagged with its tool, as an array
claude_json() { jq -c --arg t claude "${1:-.} // {} | to_entries | map(.value + {name: .key, tool: \$t})" "${@:2}"; }
codex_json() {  # config file, plus the project folder for a project config
  [ -f "$1" ] || { echo '[]'; return; }
  python3 -I -c 'import json, os, sys, tomllib
load = lambda f: tomllib.load(open(f, "rb"))
servers = load(sys.argv[1]).get("mcp_servers", {})
note = "-"
if len(sys.argv) > 2:
    user = load(os.path.expanduser("~/.codex/config.toml"))
    trust = user.get("projects", {}).get(sys.argv[2], {}).get("trust_level")
    note = "-" if trust == "trusted" else "ignored: project not trusted"
print(json.dumps([v | {"name": k, "tool": "codex", "note": note} for k, v in servers.items()]))' "$@"
}

# One line per server: tool, name, type, target, note
rows() {
  jq -r --arg guard "$GUARD" '
    .[] | . as $v |
    ([$v.command] + ($v.args // [])) as $cmd |
    (($cmd[0] // "") == $guard) as $guarded |
    (if $guarded then $cmd[2:] else $cmd end) as $run |
    [ $v.tool, $v.name,
      ($v.type // (if $v.url then "http" else "stdio" end)),
      ((if $v.url then $v.url else ($run | .[0] |= (split("/") | last) | join(" ")) end) | sub("^https?://"; "")),
      (if $guarded then "repo only" else ($v.note // "-") end)
    ] | join("\u001f")'
}

# Folder, title, subtitle and server array for each section
sections() {
  local dir d f
  printf '%s\n' "$HOME${SEP}GLOBAL${SEP}every project${SEP}$(jq -cn \
    --argjson a "$(claude_json .mcpServers ~/.claude.json)" \
    --argjson b "$(codex_json ~/.codex/config.toml)" '$a + $b')"
  jq -r '.projects // {} | to_entries[] | select((.value.mcpServers // {}) | length > 0) | .key' ~/.claude.json |
    while read -r dir; do
      printf '%s\n' "$dir${SEP}LOCAL${SEP}${dir/#$HOME/~}${SEP}$(claude_json ".projects[\"$dir\"].mcpServers" ~/.claude.json)"
    done
  for d in ~/Workspace/*/ ~/Workspace/*/projects/*/; do
    d=${d%/}
    [ -f "$d/.mcp.json" ] || [ -f "$d/.codex/config.toml" ] || continue
    local a='[]'
    [ -f "$d/.mcp.json" ] && a=$(claude_json .mcpServers "$d/.mcp.json")
    printf '%s\n' "$d${SEP}PROJECT${SEP}${d/#$HOME/~}  shared in the repo${SEP}$(jq -cn \
      --argjson a "$a" --argjson b "$(codex_json "$d/.codex/config.toml" "$d")" '$a + $b')"
  done
}

LIST=$(sections)

# Health checks: one `claude mcp list` per folder, all at once
CHECKS=$(mktemp -d)
trap 'rm -rf "$CHECKS"' EXIT
if [ $STATUS = 1 ]; then
  i=0
  while IFS=$SEP read -r dir _; do
    (cd "$dir" && claude mcp list 2>/dev/null) >"$CHECKS/$i" &
    i=$((i + 1))
  done <<<"$LIST"
  wait
fi

i=0
while IFS=$SEP read -r dir title sub json; do
  n=$i; i=$((i + 1))
  [ "$(jq 'length' <<<"$json")" -gt 0 ] || continue
  printf '\n%s%s%s  %s\n' "$BOLD$BLUE" "$title" "$RESET" "$sub"
  while IFS=$SEP read -r tool name type target note; do
    dot=""
    note=${note#-}
    if [ $STATUS = 1 ]; then
      line=""
      [ "$tool" = claude ] && line=$(grep -F "$name: " "$CHECKS/$n" | head -1 || true)
      case $line in
        *"✔"*) dot="${GREEN}●${RESET} " ;;
        *"✘"*) dot="${RED}●${RESET} "; note="${note:+$note, }failing" ;;
        *"⏸"*) dot="${YELLOW}●${RESET} "; note="${note:+$note, }needs approval" ;;
        *) dot="○ " ;;
      esac
    fi
    [ ${#target} -gt 46 ] && target="${target:0:45}…"
    pad=$((47 - ${#target}))  # printf pads by bytes, so pad by characters here
    printf '  %s%-7s %s%-12s%s %-6s %s%*s %s%s%s\n' "$dot" "$tool" "$BOLD$CYAN" "$name" "$RESET" \
      "$type" "$target" "$pad" "" "$YELLOW" "$note" "$RESET"
  done < <(rows <<<"$json")
done <<<"$LIST"
echo
