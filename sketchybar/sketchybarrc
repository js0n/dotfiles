#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top \
                 height=38 \
                 topmost=window \
                 blur_radius=30 \
                 padding_left=8 \
                 padding_right=8 \
                 color=0x00000000

##### Item Defaults #####
sketchybar --default icon.font="Hack Nerd Font:Bold:14.0" \
                     icon.color=0xff4c4f69 \
                     label.font="Hack Nerd Font:Regular:13.0" \
                     label.color=0xff4c4f69 \
                     padding_left=6 \
                     padding_right=6 \
                     icon.padding_left=4 \
                     icon.padding_right=4 \
                     label.padding_left=4 \
                     label.padding_right=4

##### Center, left to right: workspaces | system stats | volume, battery, wifi | clocks #####
sketchybar --add event aerospace_workspace_change

# Rename 10 -> 0 before sorting so the alt-0 cell leads the row, then sort -V
# so cell order is stable regardless of the order aerospace returns.
for label in $(aerospace list-workspaces --all | sed 's/^10$/0/' | sort -V); do
    sid="$label"
    [ "$label" = "0" ] && sid="10"
    sketchybar --add item space.$sid center \
               --subscribe space.$sid aerospace_workspace_change \
               --set space.$sid label="$label" \
                                label.font="Hack Nerd Font:Bold:12.0" \
                                label.width=22 \
                                label.align=center \
                                label.padding_left=0 \
                                label.padding_right=0 \
                                icon.padding_left=0 \
                                icon.padding_right=0 \
                                padding_left=2 \
                                padding_right=2 \
                                background.color=0xff7287fd \
                                background.corner_radius=6 \
                                background.height=22 \
                                background.drawing=off \
                                click_script="aerospace workspace $sid" \
                                script="$PLUGIN_DIR/aerospace.sh $sid"
done

# Center items lay out left to right in the order they are added.

# Available RAM (MB) + free disk, stacked
sketchybar --add item mem.avail center \
           --set mem.avail width=0 \
                           y_offset=6 \
                           icon=RAM \
                           icon.font="Hack Nerd Font:Bold:9.0" \
                           icon.color=0xff40a02b \
                           icon.width=28 \
                           icon.align=left \
                           icon.padding_right=0 \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.width=44 \
                           label.align=right \
           --add item disk.avail center \
           --set disk.avail y_offset=-6 \
                            update_freq=300 \
                            script="$PLUGIN_DIR/disk.sh" \
                            icon=DSK \
                            icon.font="Hack Nerd Font:Bold:9.0" \
                            icon.color=0xff6c6f85 \
                            icon.width=28 \
                            icon.align=left \
                            icon.padding_right=0 \
                            label.font="Hack Nerd Font:Regular:10.0" \
                            label.width=44 \
                            label.align=right

# CPU (peach) + GPU (blue) + RAM (green) sparklines overlaid on one 60pt graph
# (~5 min history); the later graphs pull back 60pt to sit on top of the first
sketchybar --add graph cpu.graph center 60 \
           --set cpu.graph update_freq=5 \
                           script="$PLUGIN_DIR/stats.sh" \
                           graph.color=0xfffe640b \
                           graph.fill_color=0x30fe640b \
                           graph.line_width=1.5 \
                           icon.drawing=off \
                           label.drawing=off \
                           padding_left=0 \
                           padding_right=0 \
           --add graph gpu.graph center 60 \
           --set gpu.graph graph.color=0xff1e66f5 \
                           graph.fill_color=0x201e66f5 \
                           graph.line_width=1.5 \
                           icon.drawing=off \
                           label.drawing=off \
                           padding_left=-60 \
                           padding_right=0 \
           --add graph mem.graph center 60 \
           --set mem.graph graph.color=0xff40a02b \
                           graph.fill_color=0x2040a02b \
                           graph.line_width=1.5 \
                           icon.drawing=off \
                           label.drawing=off \
                           padding_left=-60 \
                           padding_right=0

# Current CPU/GPU utilization, stacked (colors match the graph lines)
sketchybar --add item stats.cpu center \
           --set stats.cpu width=0 \
                           y_offset=6 \
                           icon=CPU \
                           icon.font="Hack Nerd Font:Bold:9.0" \
                           icon.color=0xfffe640b \
                           icon.width=28 \
                           icon.align=left \
                           icon.padding_right=0 \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.width=32 \
                           label.align=right \
           --add item stats.gpu center \
           --set stats.gpu y_offset=-6 \
                           icon=GPU \
                           icon.font="Hack Nerd Font:Bold:9.0" \
                           icon.color=0xff1e66f5 \
                           icon.width=28 \
                           icon.align=left \
                           icon.padding_right=0 \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.width=32 \
                           label.align=right

# CPU/GPU die temps, stacked
sketchybar --add item temp.cpu center \
           --set temp.cpu width=0 \
                          y_offset=6 \
                          icon=CPU \
                          icon.font="Hack Nerd Font:Bold:9.0" \
                          icon.color=0xfffe640b \
                          icon.width=28 \
                          icon.align=left \
                          icon.padding_right=0 \
                          label.font="Hack Nerd Font:Regular:10.0" \
                          label.width=32 \
                          label.align=right \
           --add item temp.gpu center \
           --set temp.gpu y_offset=-6 \
                          icon=GPU \
                          icon.font="Hack Nerd Font:Bold:9.0" \
                          icon.color=0xff1e66f5 \
                          icon.width=28 \
                          icon.align=left \
                          icon.padding_right=0 \
                          label.font="Hack Nerd Font:Regular:10.0" \
                          label.width=32 \
                          label.align=right

sketchybar --add item volume center \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

sketchybar --add item battery center \
           --set battery update_freq=120 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add item wifi center \
           --set wifi update_freq=20 \
                      label.drawing=off \
                      script="$PLUGIN_DIR/wifi.sh" \
           --subscribe wifi wifi_change system_woke

# UTC + New York time, stacked into one slot
sketchybar --add item clock.utc center \
           --set clock.utc width=0 \
                           y_offset=6 \
                           icon.drawing=off \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.color=0xff6c6f85 \
                           update_freq=10 \
                           script="$PLUGIN_DIR/clock_zones.sh" \
           --add item clock.nyc center \
           --set clock.nyc y_offset=-6 \
                           icon.drawing=off \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.color=0xff6c6f85

# Local time (timezone geolocated from external IP): full date stacked over
# 24h time with seconds + zone abbreviation
sketchybar --add item clock.date center \
           --set clock.date width=0 \
                            y_offset=6 \
                            icon.drawing=off \
                            label.font="Hack Nerd Font:Regular:10.0" \
                            label.color=0xff6c6f85 \
                            label.width=100 \
                            label.align=right \
                            update_freq=1 \
                            script="$PLUGIN_DIR/clock.sh" \
           --add item clock.time center \
           --set clock.time y_offset=-6 \
                            icon.drawing=off \
                            label.font="Hack Nerd Font:Regular:10.0" \
                            label.width=100 \
                            label.align=right \
           --subscribe clock.date system_woke

##### Finalize #####
sketchybar --update
sketchybar --trigger aerospace_workspace_change
