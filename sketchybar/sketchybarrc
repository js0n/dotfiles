#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top \
                 height=38 \
                 topmost=window \
                 blur_radius=30 \
                 padding_left=8 \
                 padding_right=8 \
                 color=0x00000000

##### Item Defaults #####
sketchybar --default icon.font="Hack Nerd Font:Bold:14.0" \
                     icon.color=0xffffffff \
                     label.font="Hack Nerd Font:Regular:13.0" \
                     label.color=0xffffffff \
                     padding_left=6 \
                     padding_right=6 \
                     icon.padding_left=4 \
                     icon.padding_right=4 \
                     label.padding_left=4 \
                     label.padding_right=4

##### Left: aerospace workspaces #####
sketchybar --add event aerospace_workspace_change

# Rename 10 -> 0 before sorting so the alt-0 cell leads the row, then sort -V
# so cell order is stable regardless of the order aerospace returns.
for label in $(aerospace list-workspaces --all | sed 's/^10$/0/' | sort -V); do
    sid="$label"
    [ "$label" = "0" ] && sid="10"
    sketchybar --add item space.$sid left \
               --subscribe space.$sid aerospace_workspace_change \
               --set space.$sid label="$label" \
                                label.font="Hack Nerd Font:Bold:12.0" \
                                label.width=26 \
                                label.align=center \
                                label.padding_left=0 \
                                label.padding_right=0 \
                                icon.padding_left=0 \
                                icon.padding_right=0 \
                                padding_left=2 \
                                padding_right=2 \
                                background.color=0xffb4befe \
                                background.corner_radius=5 \
                                background.height=20 \
                                background.drawing=off \
                                click_script="aerospace workspace $sid" \
                                script="$PLUGIN_DIR/aerospace.sh $sid"
done

# Enclosing box around the workspace cells
sketchybar --add bracket spaces '/space\..*/' \
           --set spaces background.color=0xff313244 \
                        background.corner_radius=8 \
                        background.height=26 \
                        background.border_color=0xff45475a \
                        background.border_width=1

##### Left: front app #####
sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           padding_left=10 \
                           label.font="Hack Nerd Font:Bold:12.0" \
                           label.color=0xffcdd6f4 \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Right: clock, battery, volume #####
# Local time (timezone geolocated from external IP): full date stacked over
# 24h time with seconds + zone abbreviation
sketchybar --add item clock.date right \
           --set clock.date width=0 \
                            y_offset=6 \
                            icon.drawing=off \
                            label.font="Hack Nerd Font:Regular:10.0" \
                            label.color=0xffa6adc8 \
                            label.width=100 \
                            label.align=right \
                            update_freq=1 \
                            script="$PLUGIN_DIR/clock.sh" \
           --add item clock.time right \
           --set clock.time y_offset=-6 \
                            icon.drawing=off \
                            label.font="Hack Nerd Font:Regular:10.0" \
                            label.width=100 \
                            label.align=right \
           --subscribe clock.date system_woke

# UTC + New York time, stacked into one slot
sketchybar --add item clock.utc right \
           --set clock.utc width=0 \
                           y_offset=6 \
                           icon.drawing=off \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.color=0xffa6adc8 \
                           update_freq=10 \
                           script="$PLUGIN_DIR/clock_zones.sh" \
           --add item clock.nyc right \
           --set clock.nyc y_offset=-6 \
                           icon.drawing=off \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.color=0xffa6adc8

sketchybar --add item wifi right \
           --set wifi update_freq=20 \
                      label.drawing=off \
                      script="$PLUGIN_DIR/wifi.sh" \
           --subscribe wifi wifi_change system_woke

sketchybar --add item battery right \
           --set battery update_freq=120 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

##### Right: CPU/GPU temps + CPU/RAM usage with shared sparkline #####
# Die temps, stacked
sketchybar --add item temp.cpu right \
           --set temp.cpu width=0 \
                          y_offset=6 \
                          icon=CPU \
                          icon.font="Hack Nerd Font:Bold:9.0" \
                          icon.color=0xfffab387 \
                          icon.width=28 \
                          icon.align=left \
                          icon.padding_right=0 \
                          label.font="Hack Nerd Font:Regular:10.0" \
                          label.width=32 \
                          label.align=right \
           --add item temp.gpu right \
           --set temp.gpu y_offset=-6 \
                          icon=GPU \
                          icon.font="Hack Nerd Font:Bold:9.0" \
                          icon.color=0xff89b4fa \
                          icon.width=28 \
                          icon.align=left \
                          icon.padding_right=0 \
                          label.font="Hack Nerd Font:Regular:10.0" \
                          label.width=32 \
                          label.align=right

# Current CPU/GPU utilization, stacked (colors match the graph lines)
sketchybar --add item stats.cpu right \
           --set stats.cpu width=0 \
                           y_offset=6 \
                           icon=CPU \
                           icon.font="Hack Nerd Font:Bold:9.0" \
                           icon.color=0xfffab387 \
                           icon.width=28 \
                           icon.align=left \
                           icon.padding_right=0 \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.width=32 \
                           label.align=right \
           --add item stats.gpu right \
           --set stats.gpu y_offset=-6 \
                           icon=GPU \
                           icon.font="Hack Nerd Font:Bold:9.0" \
                           icon.color=0xff89b4fa \
                           icon.width=28 \
                           icon.align=left \
                           icon.padding_right=0 \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.width=32 \
                           label.align=right

# CPU (peach) + GPU (blue) + RAM (green) sparklines overlaid on one 60pt graph
# (~5 min history)
sketchybar --add graph cpu.graph right 60 \
           --set cpu.graph update_freq=5 \
                           script="$PLUGIN_DIR/stats.sh" \
                           graph.color=0xfffab387 \
                           graph.fill_color=0x30fab387 \
                           graph.line_width=1.5 \
                           icon.drawing=off \
                           label.drawing=off \
                           padding_left=0 \
                           padding_right=0 \
           --add graph gpu.graph right 60 \
           --set gpu.graph graph.color=0xff89b4fa \
                           graph.fill_color=0x2089b4fa \
                           graph.line_width=1.5 \
                           icon.drawing=off \
                           label.drawing=off \
                           padding_left=0 \
                           padding_right=-60 \
           --add graph mem.graph right 60 \
           --set mem.graph graph.color=0xffa6e3a1 \
                           graph.fill_color=0x20a6e3a1 \
                           graph.line_width=1.5 \
                           icon.drawing=off \
                           label.drawing=off \
                           padding_left=0 \
                           padding_right=-60

# Available RAM (MB) + free disk, stacked
sketchybar --add item mem.avail right \
           --set mem.avail width=0 \
                           y_offset=6 \
                           icon=RAM \
                           icon.font="Hack Nerd Font:Bold:9.0" \
                           icon.color=0xffa6e3a1 \
                           icon.width=28 \
                           icon.align=left \
                           icon.padding_right=0 \
                           label.font="Hack Nerd Font:Regular:10.0" \
                           label.width=44 \
                           label.align=right \
           --add item disk.avail right \
           --set disk.avail y_offset=-6 \
                            update_freq=300 \
                            script="$PLUGIN_DIR/disk.sh" \
                            icon=DSK \
                            icon.font="Hack Nerd Font:Bold:9.0" \
                            icon.color=0xffa6adc8 \
                            icon.width=28 \
                            icon.align=left \
                            icon.padding_right=0 \
                            label.font="Hack Nerd Font:Regular:10.0" \
                            label.width=44 \
                            label.align=right

##### Finalize #####
sketchybar --update
sketchybar --trigger aerospace_workspace_change
